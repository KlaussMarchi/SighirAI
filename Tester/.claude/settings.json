{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": ["../docs"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { python tools/boot.py hook claude || python3 tools/boot.py hook claude; }",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
